{
  "expo": {
    "name": "Memory Map",
    "slug": "memory-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에서 현재 위치를 표시하기 위해 위치 권한이 필요합니다."
        }
      ],
      "@rnmapbox/maps"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.memorymap"
    }
  }
}
