{
  "expo": {
    "name": "Memory Map",
    "slug": "memory-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에서 현재 위치를 표시하기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "일기 사진 선택과 사진 위치 지도를 위해 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "일기 사진을 촬영하려면 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "일기 사진 선택과 사진 위치 지도를 위해 사진 보관함 접근 권한이 필요합니다.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@rnmapbox/maps",
      "expo-font",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.memory-map"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.memorymap"
    }
  }
}
